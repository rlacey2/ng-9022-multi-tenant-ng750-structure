{
  "name": "angular-responsive-preview",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch",
    "test": "ng test"
  },
  "private": true,
  
  "npm-upgrade": {
  "ignore": [
    "typescript"
  ]
},
  
  "overrides": {
    "@angular/core": "$@angular/core",
    "@angular/animations": "$@angular/animations",
    "rxjs": "$rxjs",
    "tslib": "$tslib",
    "@angular/compiler-cli": {
      "typescript": "~6.0.3"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.2.5",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-browser-dynamic": "^22.2.5",
    "@angular/router": "^22.2.5",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "typescript": "^7.0.2"
  }
}
